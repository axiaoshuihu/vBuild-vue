{
    "name": "vbuild-vue",
    "version": "1.0.1",
    "description": "",
    "main": "index.js",
    "scripts": {
        "lint:vue": "eslint .",
        "lint:style": "stylelint \"{packages,apps}/**/*.{css,scss,vue}\"",
        "lint": "pnpm lint:vue && pnpm lint:style",
        "lint-staged": "lint-staged",
        "format": "prettier --write .",
        "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md|vue)\"",
        "commit": "git-cz",
        "prepare": "husky install"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.18.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.18.0",
    "type": "module",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-git"
        }
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,tsx,vue}": "eslint --fix",
        "*.{css,scss,vue}": "stylelint --fix --allow-empty-input",
        "*.{js,cjs,mjs,ts,tsx,css,scss,md,vue,json}": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/parser": "^8.72.2",
        "commitlint": "^21.2.4",
        "cspell": "^10.4.1",
        "cz-git": "^1.14.0",
        "eslint": "^10.14.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "stylelint-config-standard-scss": "17.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "vue-eslint-parser": "^10.4.2"
    },
    "devDependencies": {
        "commitizen": "^4.3.2",
        "conventional-changelog-conventionalcommits": "^10.4.1",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "6.0.3"
    }
}
